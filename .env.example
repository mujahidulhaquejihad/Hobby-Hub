# Server
PORT=8080

# MongoDB (used when DATABASE_URL is not set)
MONGODB_URI=mongodb://localhost:27017/hobbyhub

# PostgreSQL (Sprint 1+; when set, auth and feed use pg)
# DATABASE_URL=postgresql://user:password@localhost:5432/hobbyhub

# JWT
ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret

# Cloudinary (client uploads: profile picture + post images)
# Create an account at https://cloudinary.com, then:
# Dashboard → Settings → Upload → Add upload preset → Unsigned, name e.g. UniBook
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name
REACT_APP_CLOUDINARY_UPLOAD_PRESET=UniBook
